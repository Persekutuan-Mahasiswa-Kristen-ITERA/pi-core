# PI-CORE — environment variable template.
#
# Copy this file to `.env` for local development and fill in real values.
# NEVER commit real values, and never put a secret in the repo, the bundle or logs.
#
# How secrets reach the runtime:
#   * Local dev  -> `apps/web/.dev.vars` (gitignored), used by `next dev` / `wrangler dev`.
#   * Staging / production -> Cloudflare secrets, set with:
#         pnpm --filter @pi-core/web exec wrangler secret put <NAME> --env staging
#
# Everything below is a placeholder. Values are intentionally empty.

# --- App ---------------------------------------------------------------
# ENVIRONMENT=staging                  # staging | production (non-secret Worker var)
# APP_URL=http://localhost:3000        # base URL, used for OAuth redirects

# --- Auth (Better Auth + Google OAuth) — Epic 3 ------------------------
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Database (Supabase Postgres, reached via Hyperdrive) — Epic 2 -----
# Supabase dashboard → Connect. Three strings exist; we use two of them:
#   * "Session pooler"   (port 5432, user postgres.<ref>)  -> migrations + local db:smoke
#   * "Direct connection" (db.<ref>.supabase.co:5432)      -> what HYPERDRIVE must point at
#     (the direct host is IPv6-only: Hyperdrive reaches it, most CI runners do not)
#   * "Transaction pooler" (port 6543)                     -> for serverless clients; NOT used here
# DATABASE_URL="postgresql://postgres.jegddvztnjfvtbbyyutb:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.jegddvztnjfvtbbyyutb:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# DIRECT_CONNECTION_URL="postgresql://postgres:[YOUR-PASSWORD]@db.jegddvztnjfvtbbyyutb.supabase.co:5432/postgres"
# HYPERDRIVE_ID=            # id of the Hyperdrive config bound as HYPERDRIVE in wrangler.jsonc

# --- Email allowlist (ITERA domains only, ADR-0005) --------------------
# ALLOWED_EMAIL_DOMAINS=itera.ac.id,student.itera.ac.id

