{
  "name": "@pi-core/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations and Postgres client for PI-CORE (reached from Workers via Hyperdrive).",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "echo \"no tests yet in @pi-core/db\" && exit 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:seed:rbac": "tsx --env-file-if-exists=.env scripts/seed-rbac.ts",
    "db:seed:domains": "tsx --env-file-if-exists=.env scripts/seed-domains.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@pi-core/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@pi-core/config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.36.0",
    "tsx": "^4",
    "typescript": "^5.9.2"
  }
}
