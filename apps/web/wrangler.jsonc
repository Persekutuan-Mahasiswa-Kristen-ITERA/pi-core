{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-core-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "pi-core-web-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "observability": {
        "enabled": true
      }
    },
    "production": {
      "name": "pi-core-web",
      "routes": [
        {
          "pattern": "core.pmkitera.web.id",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        // Build-time value, repeated here so `pnpm check:production` can compare it with the API origin.
        // `NEXT_PUBLIC_*` is inlined into the bundle by `next build`; setting it here does NOT change a
        // built Worker. The build command must pass it (docs/PANDUAN-DEPLOY.md §3.3).
        "NEXT_PUBLIC_API_URL": "https://api.core.pmkitera.web.id"
      },
      "observability": {
        "enabled": true
      }
    }
  }
}
