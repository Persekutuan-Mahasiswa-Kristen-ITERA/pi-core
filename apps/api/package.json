    "test": "vitest run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@pi-core/db": "workspace:*",
    "@pi-core/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.9.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@pi-core/config": "workspace:*",
    "eslint": "^9.36.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.0.0"
  }
}
