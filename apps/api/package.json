{
  "name": "@pi-core/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PI-CORE thin API Worker (Hono): /api/v1/*, RealtimeHub DO, OIDC and Hyperdrive DB access.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit",
