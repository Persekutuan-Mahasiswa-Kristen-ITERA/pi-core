# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo
.open-next/
next-env.d.ts

# Cloudflare / Workers
.wrangler/

# Expo / React Native (generated by prebuild)
.expo/
android/
ios/

# Env & secrets (never commit; .env.example only)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local media (screen recordings, sample clips) — never commit
*.mp4
*.mov
*.webm

# Test / coverage
coverage/
.nyc_output/

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Personal (non-committed) BMAD overrides / install answers
_bmad/config.user.toml
_bmad/custom/*.user.toml

# Google Cloud "Download JSON" OAuth client files. The file contains the client SECRET in plain
# text, so it must never be committed. Prefer deleting it after copying the values into the secret
# store; this pattern is the safety net, not the plan.
client_secret_*.json
